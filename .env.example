# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored — never commit real secrets.

# --- Gemini (Google AI Studio: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=your-gemini-api-key-here

# --- GitHub Personal Access Token (fine-grained, scoped to your demo repo) ---
# Needs: Contents R/W, Pull requests R/W, Issues R/W
GITHUB_TOKEN=your-github-pat-here

# --- Model tiers (override if needed) ---
GEMINI_MODEL_PRO=gemini-2.5-pro
GEMINI_MODEL_FLASH=gemini-2.5-flash

# --- Behaviour ---
MAX_DEBUG_RETRIES=3
# AUTONOMY: "checkpoint" (pause for approval) or "auto" (run straight through)
AUTONOMY=checkpoint

# --- Workspace ---
# Where repos get cloned for each run (relative to project root)
WORKSPACE_ROOT=workspaces
